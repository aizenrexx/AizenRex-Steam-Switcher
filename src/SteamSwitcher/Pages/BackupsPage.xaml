<Page x:Class="SteamSwitcher.Pages.BackupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Backups" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Copies of each profile's login and config data. Game files are never copied." />
        </StackPanel>

        <!-- Create -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Create a backup" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                           Text="Backs up config\loginusers.vdf, config.vdf, libraryfolders.vdf and the userdata folder." />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackupActiveButton" Style="{StaticResource PrimaryButton}"
                            Content="Back up active profile" Click="OnBackupActiveClick"
                            Margin="0,0,10,0" />
                    <Button x:Name="OpenFolderButton" Style="{StaticResource SubtleButton}"
                            Content="Open backups folder" Click="OnOpenFolderClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CountText" Grid.Row="0" Style="{StaticResource BodyText}"
                           Margin="0,0,0,10" Text="" />

                <DataGrid x:Name="BackupGrid" Grid.Row="1" Style="{StaticResource CleanGrid}"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Backup" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="100" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="150" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="Contents" Binding="{Binding ItemsText}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#FF23262F" CornerRadius="8"
                        Padding="14,11" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SelectedText" Grid.Column="0"
                                   Text="Select a backup to restore or delete it"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="RestoreTarget" Grid.Column="1" Width="150"
                                  SelectedIndex="0" Margin="0,0,10,0" IsEnabled="False">
                            <ComboBoxItem Content="Restore to Main" />
                            <ComboBoxItem Content="Restore to Daddy" />
                        </ComboBox>

                        <Button x:Name="RestoreButton" Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="Restore" Click="OnRestoreClick"
                                IsEnabled="False" Margin="0,0,10,0" />

                        <Button x:Name="DeleteButton" Grid.Column="3"
                                Style="{StaticResource DangerButton}"
                                Content="Delete" Click="OnDeleteClick"
                                IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
