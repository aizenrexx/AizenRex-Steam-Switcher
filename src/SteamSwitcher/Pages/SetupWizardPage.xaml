<Page x:Class="SteamSwitcher.Pages.SetupWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Welcome — let's set things up"
                       FontSize="26" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="SubtitleText"
                       Text="This runs once. Everything after it is automatic."
                       FontSize="14" Foreground="#9BA3B4" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- STEP 1: layout -->
                <Border x:Name="StepLayoutCard" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                        Background="#161B22" BorderBrush="#2A3240" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1 · How many profiles do you want?"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                        <RadioButton x:Name="DualOption" GroupName="Layout" IsChecked="True"
                                     Margin="0,14,0,0" Foreground="White">
                            <StackPanel>
                                <TextBlock Text="Two profiles — Main and Daddy" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Switch between two Steam accounts. The usual choice."
                                           FontSize="12" Foreground="#9BA3B4"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SingleOption" GroupName="Layout"
                                     Margin="0,12,0,0" Foreground="White">
                            <StackPanel>
                                <TextBlock Text="Single profile" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Just one account, managed by this app."
                                           FontSize="12" Foreground="#9BA3B4"/>
                            </StackPanel>
                        </RadioButton>

                        <CheckBox x:Name="InstallDaddyBox" IsChecked="True" Margin="0,16,0,0" Foreground="White"
                                  Content="Also install SteamDaddy automatically"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2: progress -->
                <Border x:Name="StepProgressCard" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                        Background="#161B22" BorderBrush="#2A3240" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="2 · Setting everything up"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                        <TextBlock x:Name="ProgressText" Text="Starting…"
                                   FontSize="13" Foreground="#9BA3B4" Margin="0,12,0,8" TextWrapping="Wrap"/>

                        <ProgressBar x:Name="SetupProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Background="#0D1117" Foreground="#5B8CFF"/>

                        <ItemsControl x:Name="StepLog" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#7D8694"
                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sign-in guidance -->
                <Border x:Name="LoginHintCard" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="#1B2430" BorderBrush="#2F4A6B" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Sign in once" FontWeight="SemiBold" Foreground="#8AB4F8" FontSize="15"/>
                        <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#C9D1D9" TextWrapping="Wrap"
                                   Text="Steam will open. Sign in normally, and make sure &quot;Remember my password&quot; is ticked."/>
                        <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#C9D1D9" TextWrapping="Wrap"
                                   Text="You only ever do this once per profile. Steam keeps a secure token afterwards, so switching never logs you out again."/>
                        <TextBlock x:Name="WaitingText" Margin="0,10,0,0" FontSize="12" Foreground="#9BA3B4"
                                   Text="Waiting for you to sign in…"/>
                    </StackPanel>
                </Border>

                <!-- Done -->
                <Border x:Name="DoneCard" CornerRadius="10" Padding="20"
                        Background="#13251A" BorderBrush="#2D5A3D" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="All set" FontSize="18" FontWeight="SemiBold" Foreground="#5CC98A"/>
                        <TextBlock x:Name="DoneText" Margin="0,8,0,0" FontSize="13"
                                   Foreground="#C9D1D9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SkipButton" Content="Skip for now" Width="130" Height="38"
                    Margin="0,0,10,0" Click="OnSkipClick"/>
            <Button x:Name="StartButton" Content="Start setup" Width="150" Height="38"
                    Click="OnStartClick"/>
        </StackPanel>
    </Grid>
</Page>
