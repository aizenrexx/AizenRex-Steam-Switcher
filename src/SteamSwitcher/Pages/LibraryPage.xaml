<Page x:Class="SteamSwitcher.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                       Text="Everything installed across both profiles." />
        </StackPanel>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchBox" Grid.Column="0"
                         PlaceholderText="Search by name or AppID…"
                         TextChanged="OnFilterChanged"
                         Margin="0,0,10,0" />

                <ComboBox x:Name="ProfileFilter" Grid.Column="1" Width="140"
                          SelectedIndex="0" SelectionChanged="OnFilterChanged"
                          Margin="0,0,10,0">
                    <ComboBoxItem Content="Both profiles" />
                    <ComboBoxItem Content="Main only" />
                    <ComboBoxItem Content="Daddy only" />
                </ComboBox>

                <CheckBox x:Name="HideRedist" Grid.Column="2"
                          Content="Hide redistributables" IsChecked="True"
                          Click="OnFilterChanged" VerticalAlignment="Center"
                          Margin="0,0,10,0" />

                <Button Grid.Column="3" Style="{StaticResource SubtleButton}"
                        Content="Export CSV" Click="OnExportClick" />
            </Grid>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CountText" Grid.Row="0" Style="{StaticResource BodyText}"
                           Margin="0,0,0,10" Text="" />

                <DataGrid x:Name="GamesGrid" Grid.Row="1" Style="{StaticResource CleanGrid}"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="80" />
                        <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100" />
                        <DataGridTextColumn Header="Install folder" Binding="{Binding InstallDir}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Launch bar -->
                <Border Grid.Row="2" Background="#FF23262F" CornerRadius="8"
                        Padding="14,11" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedNameText" Text="Select a game to launch it"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="SelectedHintText" Text=""
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:TextBox x:Name="LaunchArgsBox" Grid.Column="1" Width="200"
                                 PlaceholderText="Launch options (optional)"
                                 Margin="0,0,10,0" IsEnabled="False" />

                        <Button x:Name="LaunchButton" Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="Launch" Click="OnLaunchClick" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
