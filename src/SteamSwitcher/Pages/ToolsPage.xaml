<Page x:Class="SteamSwitcher.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,20">

            <TextBlock Text="Tools" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Maintenance actions for Steam and for this app's own folders." />

            <!-- Steam maintenance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Steam maintenance" Style="{StaticResource SectionHeader}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Clear web cache" Style="{StaticResource ValueText}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Deletes Steam's browser cache. Fixes a blank store or library view. Steam must be closed." />
                        </StackPanel>
                        <Button x:Name="ClearCacheButton" Grid.Column="1"
                                Style="{StaticResource SubtleButton}"
                                Content="Clear cache" Click="OnClearCacheClick"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Repair Steam service" Style="{StaticResource ValueText}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Runs SteamService.exe /repair, which fixes most client service faults." />
                        </StackPanel>
                        <Button x:Name="RepairServiceButton" Grid.Column="1"
                                Style="{StaticResource SubtleButton}"
                                Content="Run repair" Click="OnRepairServiceClick"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sync sign-in account" Style="{StaticResource ValueText}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Re-applies the auto-login for whichever profile is active now." />
                        </StackPanel>
                        <Button x:Name="SyncLoginButton" Grid.Column="1"
                                Style="{StaticResource SubtleButton}"
                                Content="Sync now" Click="OnSyncLoginClick"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Folders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Open a folder" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                               Text="Everything this app writes stays inside its own folder." />

                    <WrapPanel>
                        <Button Style="{StaticResource SubtleButton}" Content="Active Steam"
                                Click="OnOpenSteamClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Main profile"
                                Click="OnOpenMainClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Daddy profile"
                                Click="OnOpenDaddyClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="App folder"
                                Click="OnOpenAppClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Backups"
                                Click="OnOpenBackupsClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Logs"
                                Click="OnOpenLogsClick" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SubtleButton}" Content="Exports"
                                Click="OnOpenExportsClick" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Recent games -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="Recently launched" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="NoRecentText" Style="{StaticResource BodyText}"
                               Text="No games launched from this app yet." />
                    <DataGrid x:Name="RecentGrid" Style="{StaticResource CleanGrid}"
                              MaxHeight="200" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="90" />
                            <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90" />
                            <DataGridTextColumn Header="When" Binding="{Binding TimeText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
